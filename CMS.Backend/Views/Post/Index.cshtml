@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Danh sách bài viết";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">Quản lý bài viết</h2>
        <span class="badge bg-secondary">Tổng số: @Model.Count() bài</span>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://picsum.photos/300/200" : item.ImageUrl)"
                         class="card-img-top"
                         alt="@item.Title"
                         style="height: 200px; object-fit: cover;">

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold text-dark text-truncate-2">@item.Title</h5>

                        <p class="card-text text-muted flex-grow-1 text-truncate-3">@item.Content</p>

                        <hr class="text-muted opacity-25">

                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            <small class="text-muted">
                                <i class="bi bi-calendar3"></i> @item.CreatedDate.ToString("dd/MM/yyyy")
                            </small>
                            <span class="badge bg-light text-dark border">ID Danh mục: @item.CategoryId</span>
                        </div>
                    </div>

                    <div class="card-footer bg-transparent border-0 pt-0 pb-3">
                        <div class="d-grid gap-2">
                            <a href="#" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .text-truncate-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>