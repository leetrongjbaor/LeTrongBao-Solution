@model IEnumerable<CMS.Data.Entities.Post>
@{
    ViewData["Title"] = "📖 Danh Sách Bài Viết";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold">📝 DANH SÁCH BÀI VIẾT</h2>
        <span class="badge bg-secondary fs-6">Tổng: @Model.Count() bài viết</span>
    </div>

    <table class="table table-bordered table-hover table-striped">
        <thead class="table-primary">
            <tr>
                <th>ID</th>
                <th>Tiêu Đề</th>
                <th>Danh Mục</th>
                <th>Ngày Tạo</th>
                <th>Hình Ảnh</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Title</td>
                    <td><span class="badge bg-info text-dark">ID: @item.CategoryId</span></td>
                    <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Title" style="height:50px; object-fit:cover;" class="rounded">
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Không có ảnh</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>