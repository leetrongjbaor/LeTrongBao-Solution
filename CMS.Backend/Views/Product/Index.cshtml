@model IEnumerable<CMS.Data.Entities.Product>
@{
    ViewData["Title"] = "Danh Sách Sản Phẩm";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-success fw-bold">🛒 DANH SÁCH SẢN PHẨM</h2>
        <span class="badge bg-secondary fs-6">Tổng: @Model.Count() sản phẩm</span>
    </div>
    <table class="table table-bordered table-hover table-striped">
        <thead class="table-success">
            <tr>
                <th>ID</th>
                <th>Tên Sản Phẩm</th>
                <th>Danh Mục</th>
                <th>Giá (VNĐ)</th>
                <th>Tồn Kho</th>
                <th>Mô Tả</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td><span class="badge bg-info text-dark">@(item.CategoryProduct?.Name ?? "N/A")</span></td>
                    <td class="text-end">@item.Price.ToString("N0")</td>
                    <td class="text-center">
                        @* Dùng StockQuantity đúng tên property *@
                        @if (item.StockQuantity > 10)
                        {
                            <span class="badge bg-success">@item.StockQuantity</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@item.StockQuantity</span>
                        }
                    </td>
                    <td>@item.Description</td>
                </tr>
            }
        </tbody>
    </table>
</div>
