@model IEnumerable<CMS.Data.Entities.Customer>
@{
    ViewData["Title"] = "Danh Sách Khách Hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-warning fw-bold">👥 DANH SÁCH KHÁCH HÀNG</h2>
        <span class="badge bg-secondary fs-6">Tổng: @Model.Count() khách hàng</span>
    </div>
    <table class="table table-bordered table-hover table-striped">
        <thead class="table-warning">
            <tr>
                <th>ID</th>
                <th>Họ và Tên</th>
                <th>Email</th>
                <th>Điện Thoại</th>
                <th>Địa Chỉ</th>
                @* KHÔNG hiển thị Password *@
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@item.Address</td>
                </tr>
            }
        </tbody>
    </table>
</div>
